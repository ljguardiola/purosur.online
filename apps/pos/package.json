{
  "name": "@purosur/pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:production": "electron-vite build && pnpm run pack:production",
    "package:staging": "electron-vite build && pnpm run pack:staging",
    "pack:production": "cross-env POS_CHANNEL=production electron-builder --config electron-builder.config.mjs --win",
    "pack:staging": "cross-env POS_CHANNEL=staging electron-builder --config electron-builder.config.mjs --win",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@purosur/contracts": "workspace:*",
    "@purosur/domain": "workspace:*",
    "@purosur/ui": "workspace:*",
    "@sentry/electron": "^7.19.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hash-wasm": "^4.12.0",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.47.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2",
    "vite": "^7.3.6",
    "vitest-browser-react": "^2.3.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
