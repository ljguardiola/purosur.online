{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    // `-b` mode's incremental build info; kept inside dist/ (already git-ignored) instead of its
    // default location next to this file.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "references": [{ "path": "../../packages/domain" }, { "path": "../../packages/contracts" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/test-support/**"]
}
