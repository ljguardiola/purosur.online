{
  "name": "purosur-pos",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/backoffice && tsc --noEmit -p apps/pos && tsc --noEmit -p apps/cloud/tsconfig.test.json",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.mjs",
    "verify:static": "tsc --noEmit && tsc --noEmit -p apps/backoffice && tsc --noEmit -p apps/pos && tsc --noEmit -p apps/cloud/tsconfig.test.json && pnpm --filter @purosur/cloud build && pnpm --filter @purosur/backoffice build && node .github/scripts/backoffice-download-budget.mjs && pnpm --filter @purosur/pos build && biome ci . --error-on-warnings && pnpm depcruise && knip && node .github/scripts/react-compiler-check.mjs && node --test .github/scripts/*.test.mjs .github/scripts/test-support/*.test.mjs",
    "verify:tests": "vitest run --project='!catalog-visual'",
    "verify:visual": "vitest run --project=catalog-visual",
    "verify": "pnpm verify:static && pnpm verify:tests && pnpm verify:visual",
    "mutation": "stryker run stryker.config.mjs",
    "dev:db": "docker compose up -d",
    "dev:migrate": "pnpm --filter @purosur/cloud build && node --env-file=.env apps/cloud/dist/migrate.js",
    "dev:create-first-administrator": "pnpm --filter @purosur/cloud build && node --env-file=.env apps/cloud/dist/create-first-administrator.js",
    "dev:load-sample-data": "pnpm --filter @purosur/cloud build && node --env-file=.env apps/cloud/dist/load-sample-data.js",
    "dev:clear-sample-data": "pnpm --filter @purosur/cloud build && node --env-file=.env apps/cloud/dist/clear-sample-data.js",
    "dev:cloud": "pnpm --filter @purosur/cloud build && node --env-file=.env apps/cloud/dist/server.js",
    "dev:backoffice": "pnpm --filter @purosur/backoffice dev",
    "catalog": "pnpm --filter @purosur/ui catalog",
    "catalog:build": "pnpm --filter @purosur/ui catalog:build",
    "catalog:approve": "vitest run --project=catalog-visual --update",
    "ci:verify-durations": "node .github/scripts/verify-durations.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.14",
    "@rolldown/plugin-babel": "^0.2.4",
    "@secretlint/node": "^13.0.6",
    "@secretlint/secretlint-rule-pattern": "^13.0.6",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.4.0",
    "fast-check": "^4.10.2",
    "knip": "^6.38.0",
    "playwright": "^1.63.0",
    "railway": "3.11.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
