{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    // Overrides the root's `paths` (which points `@purosur/domain` at its untranspiled
    // source): this build resolves it as an ordinary package instead, through the project
    // reference below and node_modules, so it gets domain's own compiled declarations.
    "paths": {},
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "references": [{ "path": "../domain" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
