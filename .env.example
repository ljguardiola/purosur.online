# Copy to .env (gitignored) for local development: `cp .env.example .env`. See CONTRIBUTING.md's
# "Running it locally". No real credential belongs here or in .env: the log transport below never
# calls Resend, so RESEND_API_KEY is never required locally.

DATABASE_URL=postgres://purosur:purosur@localhost:5432/purosur

# The Vite dev server's own origin: apps/backoffice/vite.config.ts proxies every cloud API path
# there, so the browser only ever talks to this origin and the cloud's Origin check still applies.
BACKOFFICE_ORIGIN=http://localhost:5173

# Writes the recovery link to the process log instead of sending mail. Only the exact value "log"
# opts in; deployed environments never set this variable and always send through Resend.
RECOVERY_EMAIL_TRANSPORT=log
RECOVERY_EMAIL_FROM=Puro Sur <dev@localhost>
RECOVERY_EMAIL_REPLY_TO=dev@localhost
# Any value works locally; the backoffice dev proxy sends it as the edge header the cloud requires.
EDGE_ORIGIN_SECRET=local-edge-secret

# Password the migration sets for cloud_app, the limited role the cloud connects as; any local value works.
CLOUD_APP_DATABASE_PASSWORD=local-cloud-app-password

# ARCA X.509 certificate, public part only: the cloud reads the authorized CUIT from its
# subject. This default is a self-signed test certificate for CUIT 20-12345678-6.
ARCA_CERTIFICATE="-----BEGIN CERTIFICATE-----\nMIIDNzCCAh+gAwIBAgIUWxRlGEGJGDEzQxzKn4lYZw2xrZ8wDQYJKoZIhvcNAQEL\nBQAwKjENMAsGA1UEAwwEdGVzdDEZMBcGA1UEBRMQQ1VJVCAyMDEyMzQ1Njc4NjAg\nFw0yNjA5MjUxOTQyMTdaGA8yMTI2MDkwMTE5NDIxN1owKjENMAsGA1UEAwwEdGVz\ndDEZMBcGA1UEBRMQQ1VJVCAyMDEyMzQ1Njc4NjCCASIwDQYJKoZIhvcNAQEBBQAD\nggEPADCCAQoCggEBALrxZsZw5gClGGTTzj9V7eyllxxyn8lUMc5X79PhBzWOSgjN\nm7JnnjlBUlR8pZ9SbXeUO80jV7zzehK8Ty5uUcN1K8E2BqrAMNcfLSXQHChO0LkA\nPxbA90jnZ1draSjA7Ju3VcnRERMZNVdnPOq000vqm2f3XheEjyMg7SEZVg6kcJVI\nYpNEB6HzocKMC7TsVTy2MR3QceJxllTMmPpBvuePIWjs7/uuc+lp5LPGWdP1DLmw\nGDXqNga0pcQOjd5iXPmDrpNxo5ENmggs+uZBDkFTc+278kYVYnug2AgRZxzJvHbe\nepqZ+PJ2eptSW/PkTYl0G5sGQKA11MPnXgq03sMCAwEAAaNTMFEwHQYDVR0OBBYE\nFCNdiYR5rGm42ZEUCxM4RvTXaApOMB8GA1UdIwQYMBaAFCNdiYR5rGm42ZEUCxM4\nRvTXaApOMA8GA1UdEwEB/wQFMAMBAf8wDQYJKoZIhvcNAQELBQADggEBADG8GKzg\nePdpRvBwG+al779aYramcE3jqK6fI6wd2Hd2ElNuWj21nTizCUtHbOwPXQzO3Ae7\n/xT40krgYbOBcJ70Cbxwc09LVSchu15Rg0WG1RKiNDrO1H6u+WsF3zGd51UU7XhO\nLuwQkKH+L3Yyy3wA/0YmqdVpx6Fh1MVRO86SEzFJLLFTcUcLoQDc1HstF3Tt45VA\n0vYQ2ARsi9yJqePZRewS1b6vxlK+550hiDAw7BLkuir9PxJzL5tVhfXb2gzbf0eO\nArZyviuF8uJ7UJQzIkkb65NnVp5lI4mgSyVYZhNOknXjRIwtHvlOlZhIieeiJOGq\noWHVwAwQ06dKPhQ=\n-----END CERTIFICATE-----"
