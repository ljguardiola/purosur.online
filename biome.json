{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@purosur/domain": {
                    "message": "packages/ui must not depend on packages/domain."
                  },
                  "@purosur/contracts": {
                    "message": "packages/ui must not depend on packages/contracts."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/pos/src/renderer/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "error"
          },
          "style": {
            "useImportType": {
              "level": "error",
              "options": { "style": "separatedType" }
            },
            "useExportType": {
              "level": "error",
              "options": { "style": "separatedType" }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**", "apps/*/src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "error"
          }
        }
      },
      "plugins": ["biome-plugins/no-literal-user-text.grit"]
    }
  ]
}
