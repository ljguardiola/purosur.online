{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "style": {
        "useComponentExportOnlyModules": "off"
      }
    },
    "domains": {
      "react": "all"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@purosur/domain": {
                    "message": "packages/ui must not depend on packages/domain."
                  },
                  "@purosur/contracts": {
                    "message": "packages/ui must not depend on packages/contracts."
                  }
                },
                "patterns": [
                  {
                    "group": ["@purosur/domain/**"],
                    "message": "packages/ui must not depend on packages/domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/pos/src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": {
              "level": "error",
              "options": { "style": "separatedType" }
            },
            "useExportType": {
              "level": "error",
              "options": { "style": "separatedType" }
            }
          }
        }
      }
    }
  ]
}
