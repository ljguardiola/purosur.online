language js

// `JsxString()` matches a bare `label="x"`; `JsStringLiteralExpression()` additionally matches a
// literal placed inside the attribute's expression container, `label={"x"}`.
JsxAttribute(name=$name, initializer=$value) where {
  $name <: r"^(?:aria-label|aria-description|title|alt|placeholder|label|[a-zA-Z]+Label)$",
  $value <: contains or {
    JsxString(),
    JsStringLiteralExpression()
  },
  register_diagnostic(span=$value, message="User-facing text must come from the message catalog.")
}
