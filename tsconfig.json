{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@purosur/domain": ["./packages/domain/src/index.ts"],
      "@purosur/domain/*": ["./packages/domain/src/*"],
      "@purosur/contracts": ["./packages/contracts/src/index.ts"],
      "@purosur/contracts/*": ["./packages/contracts/src/*"],
      "@purosur/ui": ["./packages/ui/src/index.ts"],
      "@purosur/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [
    "packages/*/src",
    "apps/*/src",
    "vitest.config.ts",
    "apps/pos/electron.vite.config.ts",
    "apps/pos/e2e",
    "apps/pos/vitest.e2e.config.ts",
    ".railway/railway.ts"
  ]
}
