{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noPropertyAccessFromIndexSignature": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@purosur/domain": ["./packages/domain/src/index.ts"],
      "@purosur/domain/catalog/use-cases": ["./packages/domain/src/catalog/use-cases/index.ts"],
      "@purosur/domain/pricing/use-cases": ["./packages/domain/src/pricing/use-cases/index.ts"],
      "@purosur/contracts": ["./packages/contracts/src/index.ts"],
      "@purosur/ui": ["./packages/ui/src/index.ts"],
      "@purosur/ui/test": ["./packages/ui/src/test/index.ts"],
      "@purosur/ui/tokens.css": ["./packages/ui/src/styles/tokens.css"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/ui/.storybook",
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "apps/cloud/vitest.global-setup.ts",
    "apps/cloud/vitest.global-setup.postgres.ts",
    "packages/ui/vitest.global-setup.catalog-visual.ts",
    ".railway/railway.ts",
    ".railway/railway.test.ts"
  ]
}
