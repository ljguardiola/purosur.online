{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": [
              "/^postgresql:\\/\\/cloud_app:cloud-app-password@\\\\\\$\\{\\{Database\\.PGHOST\\}\\}/",
              "/^postgres:\\/\\/user:s3cret-password@\\[bad\\/db/",
              "/^postgresql:\\/\\/offsite_dump:[^@]*@/",
              "/^postgresql:\\/\\/u:s3cret@host\\/db/"
            ]
          }
        }
      ]
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "deployment secret assigned a value",
            "patterns": [
              "/(RAILWAY_TOKEN|RELEASE_CHECK_TOKEN|GHCR_PULL_TOKEN|RESEND_API_KEY|EDGE_ORIGIN_SECRET(?:_STAGING|_PRODUCTION)?|DEVICE_TOKEN_ROTATION_KEY|INSTALLATION_KEYS_ENCRYPTION_KEY|CLOUD_APP_DATABASE_PASSWORD|OFFSITE_DUMP_DATABASE_PASSWORD|OFFSITE_DUMP_AGE_IDENTITY|OFFSITE_DUMP_CHECK_TOKEN|OFFSITE_DUMP_READ_ACCESS_KEY_ID|OFFSITE_DUMP_READ_SECRET_ACCESS_KEY|OFFSITE_DUMP_UPLOAD_ACCESS_KEY_ID|OFFSITE_DUMP_UPLOAD_SECRET_ACCESS_KEY|ARCA_CERTIFICATE|ARCA_PRIVATE_KEY|ARCA_RECORDING_CERTIFICATE|ARCA_RECORDING_PRIVATE_KEY|MERCADOPAGO_ACCESS_TOKEN|MERCADOPAGO_WEBHOOK_SECRET|POS_UPDATES_BUCKET_ACCESS_KEY_ID|POS_UPDATES_BUCKET_SECRET_ACCESS_KEY)[\"']?\\s*[=:]\\s*[\"']?(?=[A-Za-z0-9+/=_-]*[0-9])(?=[A-Za-z0-9+/=_-]*[A-Za-z])[A-Za-z0-9+/=_-]{20,}/g"
            ]
          }
        ]
      }
    }
  ]
}
