{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-pattern",
    "@secretlint/secretlint-rule-preset-recommend"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".claude/hooks/pretool.mjs",
        "vitest.mutation.config.ts",
        ".github/scripts/validate-pr.mjs",
        ".github/scripts/validate-issue.mjs",
        ".github/scripts/parent-issue.mjs",
        ".github/scripts/sync-labels.mjs",
        ".github/scripts/slow-tests-reporter.d.mts"
      ]
    },
    "apps/cloud": {
      "entry": ["src/load-sample-data.ts", "src/clear-sample-data.ts"]
    },
    "apps/pos": {
      "entry": ["electron-builder.config.d.mts"],
      "vitest": {
        "entry": ["src/**/*.test.{ts,tsx}"]
      }
    },
    "apps/*": {},
    "packages/*": {}
  }
}
