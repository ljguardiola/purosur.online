{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-pattern",
    "@secretlint/secretlint-rule-preset-recommend"
  ],
  "ignoreFiles": [
    ".github/scripts/slow-tests-reporter.d.mts",
    ".github/scripts/without-package-output.d.mts",
    "apps/pos/electron-builder.config.d.mts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".claude/hooks/pretool.mjs",
        "vitest.mutation.config.ts",
        ".github/scripts/validate-pr.mjs",
        ".github/scripts/validate-issue.mjs",
        ".github/scripts/parent-issue.mjs",
        ".github/scripts/sync-labels.mjs"
      ]
    },
    "apps/cloud": {
      "entry": [
        "src/load-sample-data.ts",
        "src/clear-sample-data.ts",
        "src/record-arca-responses.ts",
    "src/check-arca-test-environment.ts"
      ],
      "includeEntryExports": true
    },
    "apps/pos": {
      "entry": ["src/core/sync/test-support/register-session-push.recorder.ts"],
      "vitest": {
        "entry": ["src/**/*.test.{ts,tsx}", "*.test.ts"]
      },
      "includeEntryExports": true
    },
    "apps/*": {
      "includeEntryExports": true
    },
    "packages/ui": {
      "vitest": {
        "entry": ["src/**/*.test.{ts,tsx}", "src/**/*.visual.tsx"]
      }
    },
    "packages/*": {}
  }
}
